# Workaround for multi-node kind on a cgroup v1 host (RHEL 8) with podman.
#
# Problem: systemd inside each node boots in "hybrid" mode and mounts a cgroup2
# tree at /sys/fs/cgroup/unified. On a v1 host every node container sits at the
# same spot in that tree, so all nodes share it and their systemd instances
# delete each other's kubelet cgroups -> worker kubelets fail with
# "cgroup [kubelet kubepods] has some missing paths".
#
# Fix: force pure legacy cgroup v1 mode, so each node only uses its own
# (properly isolated) v1 hierarchies. Inside a container systemd reads PID 1's
# arguments as its kernel command line.

# Start from the official kind node image (contains Kubernetes 1.31.12 and its images).
FROM docker.io/kindest/node:v1.31.12

# Same start command as the original image (kind's entrypoint, then systemd = /sbin/init),
# plus one extra argument telling systemd to use cgroup v1 only.
ENTRYPOINT ["/usr/local/bin/entrypoint", "/sbin/init", "systemd.legacy_systemd_cgroup_controller=1"]
